"Language: en-US\n"

msgid "labels.TargetMeshes"
msgstr "Target Meshes"

#. {0}: mesh count
msgid "labels.SkippedMeshes"
msgstr "Skipped meshes ({0})"

msgid "labels.Left"
msgstr "left"

msgid "labels.Right"
msgstr "right"

msgid "tooltips.TargetMeshes"
msgstr "Meshes that should follow the forearm twist. Add the body and clothing sleeves, and leave rigid accessories such as bracelets out."

msgid "tooltips.AutoAdd"
msgstr "Finds and adds meshes that should follow the forearm twist, such as the body and clothing sleeves. Rigid meshes such as bracelets and meshes that cover little of the forearm are skipped. Check the added meshes."

msgid "buttons.Select"
msgstr "Select"

msgid "buttons.AutoAdd"
msgstr "Auto-Add Target Meshes (Experimental)"

msgid "messages.NoAvatar"
msgstr "Move this component under an avatar with a VRC Avatar Descriptor."

msgid "messages.Excluded"
msgstr "This component is under an EditorOnly object or another avatar and will be ignored."

msgid "messages.DuplicateUsed"
msgstr "Multiple Elbow Fixer components were found. This component will be used."

msgid "messages.DuplicateIgnored"
msgstr "Multiple Elbow Fixer components were found. This component will be ignored."

msgid "messages.SkippedExistingTwist"
msgstr "Not added because they use a bone under a forearm twist bone or a bone with a constraint."

#. {0}: renderer name
msgid "messages.NoMesh"
msgstr "'{0}' has no mesh. Remove it from the target meshes."

#. {0}: mesh name, {1}: vertex count, {2}: vertices using the nearest segment
msgid "messages.PlanSummary"
msgstr "{0}: {1} vertices redistributed ({2} using the nearest segment)"

#. {0}: skin bone and VRC constraint count, {1}: reference object count
msgid "messages.BuildSummary"
msgstr "Added {0} skin bones, {0} VRC constraints and {1} reference objects."

#. {0}: mesh name, {1}: distance
msgid "messages.RestPoseDrift"
msgstr "{0}: rest pose drift {1:F5} mm"

msgid "errors.InvalidAvatar"
msgstr "The avatar root needs a VRC Avatar Descriptor and a valid Humanoid Animator."

msgid "errors.AlreadyFixed"
msgstr "Elbow Fixer bones already exist. Use an avatar that has not been fixed yet."

#. {0}: left or right
msgid "errors.MissingArmBones"
msgstr "The {0} arm is missing an UpperArm, LowerArm or Hand bone mapping."

#. {0}: left or right
msgid "errors.IndirectArmChain"
msgstr "The {0} arm must be a direct UpperArm > LowerArm > Hand chain."

#. {0}: left or right
msgid "errors.ShortForearm"
msgstr "The {0} forearm is too short."

#. {0}: object name
msgid "errors.UnsupportedScale"
msgstr "'{0}' has a negative or non-uniform scale."

#. {0}: bone name
msgid "errors.ExistingTwist"
msgstr "Bone '{0}' is rotated by a constraint, so it cannot be used with Elbow Fixer. Remove the constraint from this bone."

#. {0}: mesh name, {1}: bone name
msgid "errors.MeshExistingTwist"
msgstr "Mesh '{0}' is skipped because it uses a bone under '{1}', a forearm twist bone or a bone with a constraint. Remove '{0}' from the target meshes."

#. {0}: object name
msgid "errors.PrefabulousTwist"
msgstr "PA Generate Twist Bones on '{0}' cannot be used with Elbow Fixer. Remove one of them."

#. {0}: left or right
msgid "errors.ForearmParallel"
msgstr "The {0} forearm points along the avatar's forward direction. Use the original rest pose."

msgid "errors.NoMeshes"
msgstr "There are no target meshes, so nothing is fixed. Add at least one target mesh, or remove Elbow Fixer if you don't need it."

#. {0}: mesh name
msgid "errors.MeshOutsideAvatar"
msgstr "'{0}' is not part of this avatar, so it is skipped. Remove it from the target meshes."

#. {0}: mesh name, {1}: animation clip name
msgid "errors.AnimatedMesh"
msgstr "Mesh '{0}' is skipped because animation '{1}' replaces it with another mesh. Remove '{0}' from the target meshes."

#. {0}: renderer name
msgid "errors.MissingMesh"
msgstr "'{0}' is skipped because it has no mesh. Another tool may have removed or merged it."

#. {0}: mesh name
msgid "errors.MeshNotReadable"
msgstr "'{0}' is skipped because Read/Write is disabled. Enable Read/Write in its import settings."

#. {0}: mesh name
msgid "errors.ClothNotSupported"
msgstr "'{0}' has a Cloth component, which is not supported, so it is skipped. Remove it from the target meshes."

#. {0}: mesh name
msgid "errors.SkinQuality"
msgstr "'{0}' is skipped because its Quality is not Auto or 4 Bones. Set Quality to Auto or 4 Bones."

#. {0}: mesh name
msgid "errors.TooManyInfluences"
msgstr "'{0}' is skipped because it has vertices with more than four bone influences."

#. {0}: mesh name
msgid "errors.BindposeMismatch"
msgstr "'{0}' is skipped because its bone and bindpose counts differ."

#. {0}: mesh name
msgid "errors.InvalidBindpose"
msgstr "'{0}' is skipped because it has an invalid bindpose."

#. {0}: mesh name
msgid "errors.InvalidWeights"
msgstr "'{0}' is skipped because it has invalid skin weights. Weights must be zero or more and reference existing bones, and each weighted vertex must sum to 1."

#. {0}: mesh name, {1}: left or right
msgid "errors.DuplicateLowerArm"
msgstr "'{0}' is skipped because its bone list contains the {1} LowerArm bone more than once."

#. {0}: mesh name
msgid "errors.NoForearmWeights"
msgstr "'{0}' is skipped because it has no forearm weights. Remove it from the target meshes."

#. {0}: mesh name, {1}: distance
msgid "errors.RestPoseDrift"
msgstr "'{0}' moved {1} mm in the rest pose. The build was stopped."

#. {0}: mesh name
msgid "errors.NonFiniteVertices"
msgstr "'{0}' is skipped because it has NaN or infinite vertex positions."

#. {0}: mesh name
msgid "errors.NonFiniteSkinning"
msgstr "Skinning '{0}' produced NaN or infinite positions."

#. {0}: mesh name
msgid "errors.MeshEditorOnly"
msgstr "'{0}' is under an EditorOnly object and will be removed during the build, so it is skipped. Remove it from the target meshes."
