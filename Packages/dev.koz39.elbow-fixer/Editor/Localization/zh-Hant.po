msgid "errors.InvalidBindpose"
msgstr "「{0}」的綁定姿勢無效。"

#. {0}: 網格名稱
msgid "errors.InvalidWeights"
msgstr "「{0}」的蒙皮權重無效。權重必須不小於 0 並指向存在的骨骼，有權重的頂點總和必須為 1。"

#. {0}: 網格名稱, {1}: 左或右
msgid "errors.DuplicateLowerArm"
msgstr "「{0}」的骨骼清單中多次包含{1}側 LowerArm 骨骼。"

#. {0}: 網格名稱
msgid "errors.NoForearmWeights"
msgstr "「{0}」沒有可修正的前臂權重。請將其從目標網格中移除。"

#. {0}: 網格名稱, {1}: 距離
msgid "errors.RestPoseDrift"
msgstr "「{0}」在靜止姿勢下移動了 {1} mm。已中止建置。"

#. {0}: 網格名稱
msgid "errors.NonFiniteVertices"
msgstr "「{0}」的頂點位置包含 NaN 或無限大值。"

#. {0}: 網格名稱
msgid "errors.NonFiniteSkinning"
msgstr "「{0}」的蒙皮結果位置包含 NaN 或無限大值。"

#. {0}: 網格名稱
msgid "errors.MeshEditorOnly"
msgstr "「{0}」位於 EditorOnly 物件下，會在建置時被移除。請將其從目標網格中移除。"
